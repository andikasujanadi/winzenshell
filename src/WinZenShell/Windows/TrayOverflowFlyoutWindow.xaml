<Window x:Class="WinZenShell.Windows.TrayOverflowFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZen System Tray Overflow"
        Width="248"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3684E3"/>
        <SolidColorBrush x:Key="TileBg" Color="#262626"/>
        <SolidColorBrush x:Key="TileHoverBg" Color="#353535"/>
        <SolidColorBrush x:Key="TileBorder" Color="#383838"/>
        <SolidColorBrush x:Key="MutedFg" Color="#9E9E9E"/>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            Background="#1E1E1E"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12,10,12,10">
        <StackPanel>
            <DockPanel Margin="2,0,2,8" LastChildFill="False">
                <TextBlock x:Name="TxtHeaderTitle"
                           DockPanel.Dock="Left"
                           Text="System tray"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCount"
                           DockPanel.Dock="Right"
                           Text="0"
                           Foreground="{DynamicResource MutedFg}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                <WrapPanel x:Name="IconsWrapPanel" HorizontalAlignment="Left"/>
            </ScrollViewer>

            <TextBlock x:Name="TxtEmpty"
                       Visibility="Collapsed"
                       Text="No hidden tray icons running."
                       Foreground="{DynamicResource MutedFg}"
                       FontSize="11.5"
                       Margin="2,6,2,6"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="TxtHint"
                       Text="Right-click icon to pin/unpin"
                       Foreground="{DynamicResource MutedFg}"
                       FontSize="10"
                       Margin="2,6,2,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
