<Window x:Class="WinZenShell.Windows.VolumeFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZen Volume"
        Width="310" Height="82"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewMouseWheel="OnPreviewMouseWheel">

    <Window.Resources>
        <Style x:Key="Win11SliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="OuterRing" Width="18" Height="18" Fill="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse x:Name="InnerRing" Width="8" Height="8" Fill="#60CDFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Fill" Value="#ECECEC"/>
                                <Setter TargetName="InnerRing" Property="Fill" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="OuterRing" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="InnerRing" Property="Fill" Value="#0098E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11SliderRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11SliderProgressButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="6" CornerRadius="3" Background="#60CDFF" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11SliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="24">
                            <!-- Background Track -->
                            <Border Height="6" CornerRadius="3" Background="#383838" VerticalAlignment="Center"/>

                            <!-- Track with Progress & Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Win11SliderProgressButton}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Win11SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Win11SliderRepeatButton}"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 100% Solid Universal Fluent Surface -->
    <Border x:Name="OuterBorder"
            Background="#1E1E1E"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="6" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <!-- Inner Container (Borderless) -->
        <Border x:Name="InnerBorder"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>

                <!-- Speaker Icon Button (Click to Mute) -->
                <Button x:Name="BtnMute"
                        Grid.Column="0"
                        Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="OnMuteClicked"
                        ToolTip="Toggle Mute">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas Width="16" Height="16">
                            <Path x:Name="SpeakerPath" Fill="#60CDFF"
                                  Data="M11.536 14.01A8.473 8.473 0 0 0 14.026 8a8.47 8.47 0 0 0-2.49-6.01l-.708.707A7.476 7.476 0 0 1 13.025 8c0 2.071-.84 3.946-2.197 5.303l.708.707zM10.121 12.6A6.48 6.48 0 0 0 12.025 8a6.48 6.48 0 0 0-1.904-4.596l-.707.707A5.482 5.482 0 0 1 11.025 8a5.483 5.483 0 0 1-1.61 3.89l.706.71zM8.707 11.185A4.486 4.486 0 0 0 10.025 8a4.486 4.486 0 0 0-1.318-3.185l-.707.707A3.49 3.49 0 0 1 9.025 8a3.49 3.49 0 0 1-1.025 2.478l.707.707zM6.717 3.55A.5.5 0 0 1 7 4v8a.5.5 0 0 1-.812.39L3.825 10.5H1.5A.5.5 0 0 1 1 10V6a.5.5 0 0 1 .5-.5h2.325l2.363-1.89a.5.5 0 0 1 .529-.06z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Volume Slider -->
                <Slider x:Name="VolumeSlider"
                        Grid.Column="1"
                        Style="{StaticResource Win11SliderStyle}"
                        Minimum="0" Maximum="100" Value="50"
                        SmallChange="1" LargeChange="5"
                        IsMoveToPointEnabled="True"
                        ValueChanged="OnSliderValueChanged"
                        PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnSliderPreviewMouseMove"
                        PreviewMouseLeftButtonUp="OnSliderPreviewMouseLeftButtonUp"
                        VerticalAlignment="Center"/>

                <!-- Percentage / Muted Display -->
                <TextBlock x:Name="PercentLabel"
                           Grid.Column="2"
                           Text="50%"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Border>
</Window>
