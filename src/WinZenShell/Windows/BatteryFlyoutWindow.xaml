<Window x:Class="WinZenShell.Windows.BatteryFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZen Power &amp; Battery"
        Width="368"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3684E3"/>
        <SolidColorBrush x:Key="CardBg" Color="#252525"/>
        <SolidColorBrush x:Key="CardBorder" Color="#383838"/>
        <SolidColorBrush x:Key="ProgressTrackBg" Color="#383838"/>
        <SolidColorBrush x:Key="BtnBg" Color="#262626"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#383838"/>
        <SolidColorBrush x:Key="BtnFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnHover" Color="#333333"/>
        <SolidColorBrush x:Key="MutedFg" Color="#A0A0A0"/>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            Background="#1E1E1E"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18,16,18,16">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path x:Name="HeaderIcon"
                          Data="M2 5C1.45 5 1 5.45 1 6V10C1 10.55 1.45 11 2 11H12C12.55 11 13 10.55 13 10V6C13 5.45 12.55 5 12 5H2ZM14 6.5V9.5C14.55 9.5 15 9.05 15 8.5V7.5C15 6.95 14.55 6.5 14 6.5ZM2.5 6.5H11.5V9.5H2.5V6.5Z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="Power &amp; Battery"
                               Foreground="#FFFFFF"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnClose"
                        DockPanel.Dock="Right"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#9E9E9E"
                        Cursor="Hand"
                        Click="OnCloseClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2AFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>

            <!-- Battery Status Card -->
            <Border x:Name="BatteryCard"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPercent"
                                       Text="100%"
                                       Foreground="#FFFFFF"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="EnergySaverBadge"
                                    Visibility="Collapsed"
                                    Background="#2E16A34A"
                                    CornerRadius="5"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Energy Saver"
                                           Foreground="#4ADE80"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtStatus"
                                   DockPanel.Dock="Right"
                                   Text="On Battery"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Height="7" Margin="0,0,0,8">
                        <Border Background="{DynamicResource ProgressTrackBg}" CornerRadius="3.5"/>
                        <Border x:Name="BarBattery" Background="{DynamicResource AccentBrush}" CornerRadius="3.5" HorizontalAlignment="Left" Width="0"/>
                    </Grid>

                    <TextBlock x:Name="TxtDetails"
                               Text="Checking battery status..."
                               Foreground="{DynamicResource MutedFg}"
                               FontSize="11.5"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Power Plan Selector Card -->
            <Border x:Name="PowerPlanCard"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="LblPowerPlan"
                               Text="Power plan"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <StackPanel x:Name="PowerPlansPanel"/>
                </StackPanel>
            </Border>

            <!-- Bottom Action Button -->
            <Button x:Name="BtnOpenPowerSettings"
                    Height="32"
                    Background="{DynamicResource BtnBg}"
                    BorderBrush="{DynamicResource BtnBorder}"
                    BorderThickness="1"
                    Foreground="{DynamicResource BtnFg}"
                    FontSize="12"
                    FontWeight="Medium"
                    Cursor="Hand"
                    Click="OnOpenPowerSettingsClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z"
                                      Fill="{DynamicResource AccentBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,7,0"/>
                                <TextBlock Text="Battery &amp; power settings"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
