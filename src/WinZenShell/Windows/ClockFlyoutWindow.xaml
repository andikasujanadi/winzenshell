<Window x:Class="WinZenShell.Windows.ClockFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZen Clock"
        Width="290" Height="385"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- 100% Solid Opaque Universal Fluent Background so desktop icons/wallpaper never bleed through -->
    <Border x:Name="OuterBorder"
            Background="#1E1E1E"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18,16,18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"
                          Fill="#60CDFF"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="Clock &amp; Calendar"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button x:Name="BtnClose"
                        DockPanel.Dock="Right"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#9E9E9E"
                        FontSize="11"
                        Cursor="Hand"
                        Click="OnCloseClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2AFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>

            <!-- High-Contrast Analog Clock -->
            <Grid Grid.Row="1" Width="160" Height="160" HorizontalAlignment="Center" Margin="0,0,0,12">
                <!-- Outer Bezel -->
                <Ellipse Width="160" Height="160"
                         Fill="#282828"
                         Stroke="#3E3E3E"
                         StrokeThickness="2"/>

                <!-- Inner Dial Face -->
                <Ellipse Width="148" Height="148"
                         Fill="#222222"
                         Stroke="#323232"
                         StrokeThickness="1"/>

                <!-- Cardinal Numerals for Instant Readability -->
                <TextBlock Text="12" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="6" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                <TextBlock Text="7" Visibility="Collapsed"/>
                <TextBlock Text="9" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>

                <!-- 12 Hour & Minute Ticks -->
                <Canvas Width="160" Height="160" x:Name="TickCanvas"/>

                <!-- Hour Hand (Crisp Thick White) -->
                <Line X1="80" Y1="80" X2="80" Y2="44"
                      Stroke="#FFFFFF"
                      StrokeThickness="4.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="HourHandTransform" CenterX="80" CenterY="80" Angle="0"/>
                    </Line.RenderTransform>
                </Line>

                <!-- Minute Hand (Crisp Solid White) -->
                <Line X1="80" Y1="80" X2="80" Y2="26"
                      Stroke="#FFFFFF"
                      StrokeThickness="2.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="MinuteHandTransform" CenterX="80" CenterY="80" Angle="0"/>
                    </Line.RenderTransform>
                </Line>

                <!-- Second Hand (Vibrant Cyan Blue with Tail) -->
                <Line X1="80" Y1="94" X2="80" Y2="18"
                      Stroke="#60CDFF"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="SecondHandTransform" CenterX="80" CenterY="80" Angle="0"/>
                    </Line.RenderTransform>
                </Line>

                <!-- Center Pivot -->
                <Ellipse Width="9" Height="9"
                         Fill="#60CDFF"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                <Ellipse Width="3.5" Height="3.5"
                         Fill="#FFFFFF"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- Digital Time & Date Card (High Contrast Solid Card) -->
            <Border x:Name="DigitalCard"
                    Grid.Row="2"
                    Background="#262626"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtDigitalTime"
                               Text="00:00:00"
                               Foreground="#FFFFFF"
                               FontSize="30"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="TxtDigitalDate"
                               Text="Loading date..."
                               Foreground="#60CDFF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Timezone and Region Info -->
            <Border x:Name="TzBadge"
                    Grid.Row="3"
                    Background="#222222"
                    CornerRadius="6"
                    Padding="8,5"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTimezone"
                           Text="UTC Local Time"
                           Foreground="#A4A4A4"
                           FontSize="11"
                           FontWeight="Medium"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
