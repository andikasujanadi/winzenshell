<Window x:Class="WinZenShell.Windows.BrightnessFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZen Brightness"
        Width="310" Height="82"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewMouseWheel="OnPreviewMouseWheel">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
        <Style x:Key="Win11SliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="OuterRing" Width="18" Height="18" Fill="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse x:Name="InnerRing" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Fill" Value="#ECECEC"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="OuterRing" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11SliderRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11SliderProgressButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11SliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="24">
                            <!-- Background Track -->
                            <Border Height="6" CornerRadius="3" Background="#383838" VerticalAlignment="Center"/>

                            <!-- Track with Progress & Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Win11SliderProgressButton}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Win11SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Win11SliderRepeatButton}"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 100% Solid Universal Fluent Surface -->
    <Border x:Name="OuterBorder"
            Background="#1E1E1E"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,12">

        <!-- Inner Container (Borderless) -->
        <Border x:Name="InnerBorder"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <!-- Brightness Icon -->
                <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Path x:Name="BrightnessIconPath" Fill="{DynamicResource AccentBrush}" Data="M8,11 A3,3 0 1 1 8,5 A3,3 0 0 1 8,11 M8,12 A4,4 0 1 0 8,4 A4,4 0 0 0 8,12 M8,0 A0.5,0.5 0 0 1 8.5,0.5 L8.5,2.5 A0.5,0.5 0 0 1 7.5,2.5 L7.5,0.5 A0.5,0.5 0 0 1 8,0 M8,13 A0.5,0.5 0 0 1 8.5,13.5 L8.5,15.5 A0.5,0.5 0 0 1 7.5,15.5 L7.5,13.5 A0.5,0.5 0 0 1 8,13 M16,8 A0.5,0.5 0 0 1 15.5,8.5 L13.5,8.5 A0.5,0.5 0 0 1 13.5,7.5 L15.5,7.5 A0.5,0.5 0 0 1 16,8 M3,8 A0.5,0.5 0 0 1 2.5,8.5 L0.5,8.5 A0.5,0.5 0 0 1 0.5,7.5 L2.5,7.5 A0.5,0.5 0 0 1 3,8 M13.657,2.343 A0.5,0.5 0 0 1 13.657,3.05 L12.243,4.465 A0.5,0.5 0 1 1 11.536,3.757 L12.95,2.343 A0.5,0.5 0 0 1 13.657,2.343 M4.464,11.536 A0.5,0.5 0 0 1 4.464,12.243 L3.05,13.657 A0.5,0.5 0 0 1 2.343,12.95 L3.757,11.536 A0.5,0.5 0 0 1 4.464,11.536 M13.657,13.657 A0.5,0.5 0 0 1 12.95,13.657 L11.536,12.243 A0.5,0.5 0 0 1 12.243,11.536 L13.657,12.95 A0.5,0.5 0 0 1 13.657,13.657 M4.464,4.465 A0.5,0.5 0 0 1 3.757,4.465 L2.343,3.05 A0.5,0.5 0 1 1 3.05,2.343 L4.464,3.757 A0.5,0.5 0 0 1 4.464,4.465"/>
                    </Canvas>
                </Viewbox>

                <!-- Brightness Slider -->
                <Slider x:Name="BrightnessSlider"
                        Grid.Column="1"
                        Style="{StaticResource Win11SliderStyle}"
                        Minimum="0" Maximum="100" Value="100"
                        SmallChange="1" LargeChange="5"
                        IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnSliderPreviewMouseMove"
                        PreviewMouseLeftButtonUp="OnSliderPreviewMouseLeftButtonUp"
                        VerticalAlignment="Center"/>

                <!-- Percentage Display -->
                <TextBlock x:Name="PercentLabel"
                           Grid.Column="2"
                           Text="100%"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Border>
</Window>
