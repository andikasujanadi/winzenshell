<Window x:Class="WinZenShell.Windows.NetworkFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZen Network &amp; Wi-Fi"
        Width="368" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3684E3"/>

        <!-- Custom Fluent ScrollBar Resources & Styles -->
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#4AFFFFFF"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#7AFFFFFF"/>

        <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource ScrollBarThumbBrush}"
                                CornerRadius="3"
                                Width="5"
                                HorizontalAlignment="Center"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                <Setter TargetName="ThumbBorder" Property="Width" Value="6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ThumbBorder" Property="Width" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FluentScrollBar}"/>

        <Style x:Key="FluentScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="0,0,4,0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource FluentScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ToolButton Resources & Styles -->
        <SolidColorBrush x:Key="ToolBtnBg" Color="#262626"/>
        <SolidColorBrush x:Key="ToolBtnBorder" Color="#383838"/>
        <SolidColorBrush x:Key="ToolBtnFg" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ToolBtnHover" Color="#333333"/>

        <Style x:Key="FluentToolButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentLinkButton" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 100% Solid Opaque Universal Fluent Background -->
    <Border x:Name="OuterBorder"
            Background="#1E1E1E"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16,14,16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Active Connection Card -->
                <RowDefinition Height="Auto"/> <!-- 2: Wi-Fi Section Header & Refresh -->
                <RowDefinition Height="*"/>    <!-- 3: Available Networks List -->
                <RowDefinition Height="Auto"/> <!-- 4: Footer Shortcuts -->
            </Grid.RowDefinitions>

            <!-- 0: Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path x:Name="HeaderIconPath"
                          Data="M2.03 8.23A14.10 14.10 0 0 1 21.97 8.23A0.90 0.90 0 0 1 20.70 9.50A12.30 12.30 0 0 0 3.30 9.50A0.90 0.90 0 0 1 2.03 8.23ZM4.91 10.86A10.20 10.20 0 0 1 19.09 10.86A0.90 0.90 0 0 1 17.84 12.16A8.40 8.40 0 0 0 6.16 12.16A0.90 0.90 0 0 1 4.91 10.86ZM7.70 13.59A6.30 6.30 0 0 1 16.30 13.59A0.90 0.90 0 0 1 15.07 14.91A4.50 4.50 0 0 0 8.93 14.91A0.90 0.90 0 0 1 7.70 13.59ZM12.0 16.40a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="Network &amp; Wi-Fi"
                               Foreground="#FFFFFF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>

                <Button x:Name="BtnClose"
                        DockPanel.Dock="Right"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#9E9E9E"
                        FontSize="11"
                        Cursor="Hand"
                        Click="OnCloseClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2AFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>

            <!-- 1: Active Connection Status Card -->
            <Border x:Name="StatusCard"
                    Grid.Row="1"
                    Background="#262626"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="6"
                            Background="#18FFFFFF"
                            Margin="0,0,10,0">
                        <ContentPresenter x:Name="StatusIconHost"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <!-- Status Text Stack -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusName"
                                   Text="Ethernet"
                                   Foreground="#FFFFFF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtStatusDetail"
                                   Text="Connected • 172.168.100.18"
                                   Foreground="#A0A0A0"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Action Button (Disconnect Wi-Fi if connected) -->
                    <Button x:Name="BtnDisconnectWifi"
                            Grid.Column="2"
                            Content="Disconnect"
                            Padding="8,4"
                            FontSize="11"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="OnDisconnectWifiClicked"
                            Style="{StaticResource FluentToolButton}"/>
                </Grid>
            </Border>

            <!-- 2: Wi-Fi Section Header & Refresh Button -->
            <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAvailableHeader"
                               Text="Available Wi-Fi Networks"
                               Foreground="#CCCCCC"
                               FontSize="11.5"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtScanningIndicator"
                               Text="• Scanning..."
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               Margin="6,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button x:Name="BtnRefreshWifi"
                        DockPanel.Dock="Right"
                        Style="{StaticResource FluentToolButton}"
                        Padding="8,4"
                        Cursor="Hand"
                        Click="OnRefreshClicked"
                        ToolTip="Refresh Wi-Fi Networks">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="RefIcon"
                              Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Fill="{DynamicResource ToolBtnFg}"
                              Width="11" Height="11"
                              Stretch="Uniform"
                              Margin="0,0,5,0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="RefRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="RefText" Text="Refresh" Foreground="{DynamicResource ToolBtnFg}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- 3: Available Networks List -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource FluentScrollViewer}"
                          Margin="0,0,0,10">
                <StackPanel x:Name="NetworksContainer">
                    <!-- Populated dynamically via code-behind -->
                </StackPanel>
            </ScrollViewer>

            <!-- 4: Footer Shortcuts -->
            <Border Grid.Row="4"
                    BorderBrush="#20888888"
                    BorderThickness="0,1,0,0"
                    Padding="0,8,0,0">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnWindowsWifiSettings"
                            DockPanel.Dock="Left"
                            Style="{StaticResource FluentLinkButton}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontSize="11.5"
                            FontWeight="Medium"
                            Cursor="Hand"
                            Click="OnOpenSettingsClicked">
                        <TextBlock Text="Network settings"/>
                    </Button>

                    <Button x:Name="BtnWindowsNetworksPrompt"
                            DockPanel.Dock="Right"
                            Style="{StaticResource FluentLinkButton}"
                            Foreground="#9E9E9E"
                            FontSize="11"
                            Cursor="Hand"
                            Click="OnOpenWindowsNetworksClicked"
                            ToolTip="Open Windows native network flyout">
                        <TextBlock Text="Windows quick connect ›"/>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
