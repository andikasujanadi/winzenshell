<Window x:Class="WinZenShell.Windows.SystemMonitorFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZen System Monitor"
        Width="310" Height="265"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- 100% Solid Opaque Universal Fluent Surface -->
    <Border x:Name="OuterBorder"
            Background="#1E1E1E"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18,16,18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Universal Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path Data="M5 0a.5.5 0 0 1 .5.5V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h.5A2.5 2.5 0 0 1 14 4.5v.5h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v.5a2.5 2.5 0 0 1-2.5 2.5H11v1.5a.5.5 0 0 1-1 0V14H9v1.5a.5.5 0 0 1-1 0V14H7v1.5a.5.5 0 0 1-1 0V14H5.5A2.5 2.5 0 0 1 3 11.5V11H1.5a.5.5 0 0 1 0-1H3V9H1.5a.5.5 0 0 1 0-1H3V7H1.5a.5.5 0 0 1 0-1H3v-.5A2.5 2.5 0 0 1 5.5 2H6V.5A.5.5 0 0 1 5 0zm-.5 3A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 11.5 3h-7zM5 5h6v6H5V5z"
                          Fill="#60CDFF"
                          Width="15" Height="15"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="Performance &amp; Telemetry"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button x:Name="BtnClose"
                        DockPanel.Dock="Right"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#9E9E9E"
                        FontSize="11"
                        Cursor="Hand"
                        Click="OnCloseClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2AFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>

            <!-- Universal Card: CPU -->
            <Border x:Name="CpuCard" Grid.Row="1" Background="#252525" BorderBrush="#383838" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="LblCpu" Text="CPU Usage" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtCpuVal" Text="0%" Foreground="#60CDFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1" Height="6">
                        <Border Background="#383838" CornerRadius="3"/>
                        <Border x:Name="BarCpu" Background="#60CDFF" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Universal Card: RAM -->
            <Border x:Name="RamCard" Grid.Row="2" Background="#252525" BorderBrush="#383838" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="LblRam" Text="Memory (RAM)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtRamVal" Text="0%" Foreground="#C084FC" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1" Height="6" Margin="0,0,0,6">
                        <Border Background="#383838" CornerRadius="3"/>
                        <Border x:Name="BarRam" Background="#C084FC" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>

                    <TextBlock Grid.Row="2" x:Name="TxtRamDetails" Text="0.0 GB of 0.0 GB in use" Foreground="#A0A0A0" FontSize="11" FontWeight="Medium"/>
                </Grid>
            </Border>

            <!-- Universal Bottom Action Button -->
            <Button Grid.Row="4"
                    x:Name="BtnOpenTaskMgr"
                    Height="32"
                    Background="#262626"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    Foreground="#FFFFFF"
                    FontSize="12"
                    FontWeight="Medium"
                    Cursor="Hand"
                    Click="OnOpenTaskMgrClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V3zm1 0v10h12V3H2zm2 7.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .4.2l1.6 2.133 2.4-5.6a.5.5 0 0 1 .92 0l1.6 3.733H13a.5.5 0 0 1 0 1h-1.5a.5.5 0 0 1-.46-.31L9.6 7.467 7.2 13.067a.5.5 0 0 1-.92 0L4.8 11H3.5a.5.5 0 0 1-.5-.5z"
                                      Fill="#60CDFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/>
                                <TextBlock Text="Open Task Manager" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#333333"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4C4C4C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
